# Firebase Web App settings (public in the built frontend)
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.web.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace-me

# Cloud Run API URL returned by `gcloud run deploy`
VITE_API_BASE_URL=https://your-cloud-run-service-url
